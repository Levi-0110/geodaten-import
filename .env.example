# Vorlage für die Datei .env (wird von docker compose automatisch gelesen).
# Kopieren:  cp .env.example .env  und die Werte anpassen.
# Die Datei .env enthält Zugangsdaten und gehört nicht ins Repository.

# Datenbank (Dienst brandenburg_db, wie im MOSIDI-System)
POSTGRES_DB=brandenburg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte-ein-sicheres-passwort-setzen

# Zugang der Pipeline. Für die Demo genügt der Datenbank-Administrator; im Betrieb
# eine eigene Rolle ohne DDL-Rechte anlegen (siehe docs/betrieb.md) und hier eintragen.
GEOIMPORT_DB_USER=postgres
GEOIMPORT_DB_PASSWORD=bitte-ein-sicheres-passwort-setzen

# Standardtakt der Pipeline (crontab: Minute Stunde Tag Monat Wochentag) für Quellen
# ohne eigenes "schedule" in ihrer YAML-Datei (INKAR z. B. monatlich)
GEOIMPORT_CRON=0 3 * * 1

# Protokollstufe: DEBUG, INFO, WARNING, ERROR
GEOIMPORT_LOG_LEVEL=INFO
